-- SPDX-License-Identifier: MPL-2.0
-- Copyright (c) Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>
--
-- Machine-check package for the VclTotal proof corpus (Phase 1,
-- hyperpolymath/standards#124). The shipped sources live at flat paths
-- (src/core/*.idr, src/interface/abi/*.idr) but declare VclTotal.* modules,
-- so `corpus/` is a module->path tree of symlinks into src/ (edits to src/
-- are checked here verbatim). Build with idris2 0.8.0:
--
--   idris2 --build verification/proofs/vclut-core.ipkg
--
-- A zero-exit `--build` means the entire Phase-1 corpus typechecks with no
-- proof-escape symbols. See VERIFICATION-STANCE.adoc for what that does and
-- does not establish.
--
-- SCOPE: the hypatia<->verisim safety-predicate corpus. As of 2026-06-14
-- this is ABI.{Types, Layout, LayoutProofs} + Core.* + Interface.Wire*
-- (the 12 modules listed below). `VclTotal.ABI.Layout` was made sound and
-- is now included; `VclTotal.ABI.LayoutProofs` discharges its genuine
-- alignment / no-padding / bounds theorems (the former `Nat` `(-)` error in
-- `paddingFor` was fixed, and the unsound `alignUpCorrect` /
-- `queryPlanHeaderNoPadding` claims were deleted, not faked). Still NOT
-- listed: the Foreign bindings (`module Foreign` in src/abi/Foreign.idr,
-- `VclTotal.Legacy.Foreign` in src/interface/legacy/Foreign.idr) — out of
-- scope and imported by nothing in the corpus. See VERIFICATION-STANCE.adoc.

package vclut-core
version = 0.1.0
authors = "Jonathan D.A. Jewell (hyperpolymath)"
depends = contrib
sourcedir = "corpus"

modules = VclTotal.ABI.Types
        , VclTotal.ABI.Layout
        , VclTotal.ABI.LayoutProofs
        , VclTotal.Core.Grammar
        , VclTotal.Core.Schema
        , VclTotal.Core.Decide
        , VclTotal.Core.Levels
        , VclTotal.Core.Checker
        , VclTotal.Core.Composition
        , VclTotal.Core.Epistemic
        , VclTotal.Interface.WireDecode
        , VclTotal.Interface.WireConformance
