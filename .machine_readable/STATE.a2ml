#
# Canonical project checkpoint for VCL-UT. Update this file only; the former
# byte-identical .machine_readable/6a2/STATE.a2ml mirror has been removed.

[metadata]
project = "vcl-ut"
version = "0.1.0"
last-updated = "2026-10-03"
status = "active"  # active | paused | archived

[project-context]
name = "VCL-UT"
expansion = "VeriSim Consonance Language, Usage-Tracked"
purpose = "Proof-bearing safety pipeline for VCL propositions and epistemic requests to a consonance engine."
primary-consumer = "VeriSimDB / Verisim"
phase = "implementation-and-integration"

[implementation]
source-of-truth = "Rust parser and versioned wire codec; Idris2 corpus specifies and checks safety predicates; Zig/Rust interfaces provide consumer boundaries."
source-language-levels = "L0-L6 currently expressible by surface syntax; L7-L10 are specified/proved but not yet expressible by the Rust parser."
proof-corpus = "verification/proofs/vclut-core.ipkg"
proof-corpus-modules = 12
proof-corpus-idris-version = "0.8.0"
proof-corpus-totality = true
proof-corpus-zero-escape-hatches = true
proof-corpus-ci = ".github/workflows/proof-corpus.yml"
producer-gate = "src/interface/parse/src/bin/vclt-gate.rs; contract v1 is documented in docs/vclt-gate-contract.adoc"
consumer-integration = "The VeriSimDB consumer-side invocation is not yet present in this repository; see ROADMAP.adoc."

[verification]
authoritative-limitations = "verification/proofs/VERIFICATION-STANCE.adoc"
proof-corpus-status = "Documented as a clean 12-module Idris2 0.8.0 build under %default total with zero proof escapes; CI enforces rebuilding and scanning."
local-reproduction-caveat = "On worktrees with core.symlinks=false, remove verification/proofs/build and restore the corpus symlinks before trusting local proof results; see VERIFICATION-STANCE.adoc."
known-limitations = [
  "L3 null-safety treats subqueries as opaque and uses a structural NULL-guard recogniser, not dataflow analysis.",
  "Idris2 0.8.0 cannot preserve arbitrary NaN payload bits in the certified decoder; Rust tests retain the bit-exact float witness.",
  "Some cross-module Refl reductions involving find/elemBy do not reduce in Idris2 0.8.0; the documented Rust-side pinning and input-value conformance remain part of the trust boundary.",
  "Tier-2 C-ABI Ed25519 attestation is a trusted-certifier fallback and cannot be independently rechecked like Tier-1 recomputation in the wasm consumer.",
]

[reconciliation]
issue-51 = "Closed: CodeQL scheduled scan interval reconciled to monthly; push and pull_request scans remain enabled."
issue-52 = "Closed: Tier-2 Idris bindings, legacy Foreign retirement, L10 transitive-cycle work, and proof corpus are present in the current source tree."
branch-state = "At checkout time only main was published and stale checkpoint branch names were absent; this reconciliation branch is being prepared for review."
contractile-layout = "The distinct roles of legacy .contractile declarations, operational .machine_readable/contractiles, contractile.just source files, and docs/templates are documented in .machine_readable/README.adoc."
issue-53 = "Implementation is prepared on the review branch; final owner confirmation of the MPL/CC policy and required-check branch protection remain."

[licensing]
code-and-configuration = "MPL-2.0"
documentation = "CC-BY-SA-4.0"
policy-source = ".machine_readable/compliance/license-policy.toml"
reuse-map = "REUSE.toml"
license-evidence = "Root LICENSE and Cargo manifests declare MPL-2.0; docs are tagged or annotated CC-BY-SA-4.0 where applicable."

[nearest-work]
actions = [
  "Add surface syntax and tests for L7-L10 without weakening fail-closed behavior.",
  "Wire vclt-gate into the VeriSimDB consumer against the frozen v1 contract.",
  "Reconcile the documented HEXAD compatibility path with VeriSimDB's OCTAD schema contract before removing it.",
  "Keep verification/proofs/VERIFICATION-STANCE.adoc as the authority for proven guarantees and disclosed limitations.",
  "Make the REUSE and license-policy checks required in GitHub branch protection after the check is visible on main.",
]

[ecosystem]
primary-target = "VeriSimDB / Verisim"
related-components = ["echidna proof engine", "hypatia"]

[checkpoint]
validation-environment = "Agent sandbox, 2026-10-03"
validation-note = "REUSE 6.2.0 plus the license-policy checker, strict A2ML validation, TOML/JSON parsing, YAML parsing, pre-commit config validation, and shell syntax checks passed. Idris2, Cargo, and Nickel are unavailable locally. Full pre-commit execution is blocked by the existing unavailable hyperpolymath/a2ml-pre-commit remote; strict K9 validation also flags the pre-existing container/deploy.k9.ncl envelope-format mismatch. GitHub branch-protection settings are not accessible to this integration."
